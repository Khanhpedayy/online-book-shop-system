{
  "info": {
    "_postman_id": "22e02fcc-c8f8-4315-bb8d-8b6f4ffc8e5b",
    "name": "Online Book Shop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "List all books",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Get book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/1"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order (Customer - login required)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{\"bookId\": 1, \"quantity\": 1}],\n  \"email\": \"customer@example.com\",\n  \"shippingAddress\": \"456 Oak Ave\",\n  \"recipientName\": \"Jane Doe\",\n  \"customerId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Get order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/1"
          }
        },
        {
          "name": "Get orders by customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/customer/1"
          }
        },
        {
          "name": "Checkout from cart",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"shippingAddress\": \"123 Main St\",\n  \"recipientName\": \"John Doe\",\n  \"customerId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/orders/from-cart/{{cartId}}"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Create cart (customer only)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"customerId\": 1\n}"},
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Get or create customer cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/cart/customer/1"
          }
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/cart/{{cartId}}"
          }
        },
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/api/cart/{{cartId}}/items"
          }
        },
        {
          "name": "Update cart item",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"quantity\": 3\n}"},
            "url": "{{baseUrl}}/api/cart/{{cartId}}/items/1"
          }
        },
        {
          "name": "Remove from cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/cart/{{cartId}}/items/1"
          }
        },
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "cartId", "value": "paste-from-get-customer-cart-response"}
  ]
}
