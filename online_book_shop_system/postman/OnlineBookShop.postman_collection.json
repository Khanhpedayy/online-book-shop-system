  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "List all books",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "Get book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/1"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order (Guest checkout)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{\"bookId\": 1, \"quantity\": 2}],\n  \"email\": \"guest@example.com\",\n  \"shippingAddress\": \"123 Main St, City\",\n  \"recipientName\": \"John Doe\"\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Place order (Customer)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{\"bookId\": 1, \"quantity\": 1}],\n  \"email\": \"customer@example.com\",\n  \"shippingAddress\": \"456 Oak Ave\",\n  \"recipientName\": \"Jane Doe\",\n  \"customerId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Get order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/1"
          }
        },
        {
          "name": "Get orders by customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/orders/customer/1"
          }
        }
      ]
    }
  ],
  "variable": [{"key": "baseUrl", "value": "http://localhost:8080"}]
