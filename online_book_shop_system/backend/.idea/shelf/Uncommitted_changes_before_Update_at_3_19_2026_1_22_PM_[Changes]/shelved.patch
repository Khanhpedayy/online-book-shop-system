+            r.setCopyCode(rs.getString("copy_code"));
+            r.setLocation(rs.getString("location"));
+            r.setCopyStatus(rs.getString("copy_status"));
+            r.setPickMethod(rs.getString("pick_method"));
+            Timestamp t = rs.getTimestamp("picked_at");
