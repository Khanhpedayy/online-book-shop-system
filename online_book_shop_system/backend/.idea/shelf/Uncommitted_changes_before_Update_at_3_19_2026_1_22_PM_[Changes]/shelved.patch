+            Timestamp t = rs.getTimestamp("created_at");
+            r.setCreatedAt(t == null ? null : t.toLocalDateTime());
+            return r;
+        });
+    }
+
+    public record OrderItemForReturn(long orderItemId,
+                                     long orderId,
+                                     long variantId,
+                                     Long allocatedCopyId,
+                                     String skuSnapshot,
