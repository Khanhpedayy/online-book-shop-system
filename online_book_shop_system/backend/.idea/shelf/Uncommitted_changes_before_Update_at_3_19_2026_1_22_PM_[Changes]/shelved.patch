+          <th>PaymentId</th>
+          <th>Order</th>
+          <th>Status</th>
+          <th class="text-end">Amount</th>
+          <th>Provider</th>
+          <th>TxId</th>
+          <th></th>
+        </tr>
+        </thead>
+        <tbody>
+        <tr th:each="r : ${rows}">
+          <td class="mono" th:text="${r.paymentId}">1</td>
+          <td>
+            <a class="btn btn-sm btn-outline-primary"
+               th:href="@{/staff/orders/{id}(id=${r.orderId})}">
+              <span class="mono" th:text="${r.orderCode}">ODR</span>
